# Ragtech UPS - Configuracao local
# Copie para ups-config.conf e ajuste os valores.

UPS_NAME="ragtech700"
NUT_HOST="127.0.0.1"
NUT_PORT="3493"

MAC_HOST="192.0.2.20"
MAC_USER="macuser"
SSH_KEY_FILE="macmini_ups"

MAC_DELAY=30
QNAP_DELAY=60

CHARGE_LIMIT=50
SECONDS_PER_PERCENT=15
MAX_EXTRA=600

STABILIZATION=90
MIN_SAMPLE_SECONDS=60
MIN_SAMPLE_DROP=2
RATE_SAFETY_PERCENT=50

INTERVAL=5
RETRY_INTERVAL=10
MAC_TIMEOUT=30
